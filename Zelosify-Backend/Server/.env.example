# Run npm run setup:local to generate private local service configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AWS_PROFILE=zelosify
AWS_REGION=ap-southeast-2
S3_AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=

# Default 1500ms follows the brief. Longer local development timeout was explicitly approved.
AI_PROCESSING_TIMEOUT_MS=1500
AI_WORKER_ENABLED=true
# Optional pacing for low provider quotas; waits count toward processing time.
GEMINI_MIN_REQUEST_INTERVAL_MS=6000
