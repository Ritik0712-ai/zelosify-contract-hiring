    "ajv": "^8.17.1",
    "axios": "^1.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "fflate": "^0.8.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "multer": "^2.0.1",
    "otplib": "^12.0.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "uuid": "^11.0.5"
  },
