    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "test": "vitest --config vitest.config.ts",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "check:auth": "node scripts/check-auth.mjs",
    "seed:hiring": "node scripts/seed-hiring.mjs && node scripts/sync-demo-users.mjs",
    "check:hiring": "node scripts/check-hiring.mjs",
    "fixtures:demo": "node scripts/demo-fixtures.mjs",
    "benchmark:ai": "tsx scripts/benchmark-recommendations.ts",
    "check:recommendations": "node scripts/check-recommendations.mjs",
    "test:local": "node scripts/test-local.mjs"
  },
  "keywords": [],
